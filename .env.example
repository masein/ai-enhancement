# Copy to .env next to docker-compose.yml and fill in. One-liner:
#   cp .env.example .env && sed -i "s|^BIND=.*|BIND=$(tailscale ip -4)|" .env

# The directory that holds results/, eval_tasks/, logs/ (and gains service.sqlite3).
BENCH_ROOT=/home/masein/benchmarks

# Your HF cache+auth dir (holds downloaded models AND your accepted licenses).
HF_HOME=/home/masein/hf-cache

# The IP to publish on — your Tailscale IP, so only the tailnet can reach it.
BIND=100.0.0.0

# Optional:
# TZ=Asia/Dubai            # DISPLAY timezone: the page's timestamps render in it
#                          # (the team is in Dubai, +04; it changes nothing stored)
# TITLE=Team model benchmark — teraformer-5090-3
# MAX_PARAMS_B=4
# SUBMIT_TOKEN=change-me-then-share-http://host:8899/?token=change-me

# ARTIFACT_MAX_GB=30       # per-checkpoint upload cap (the API client's zip)
# UPLOAD_MAX_GB=30         # 16b: one file added from a browser
# UPLOAD_FREE_GB=50        # 16b: an upload never leaves less free on the disk
# ARTIFACT_QUOTA_GB=150    # total artifact storage
# CONTROL_TASKS_DIR=/app/eval_tasks/mmlu_perm   # where suite=control finds mmlu_perm; the repo copy by default

# The LLM behind "propose a skill spec" and data generation (DIAGNOSE.md, phase 4).
# Batch API only. Leave LLM_PROVIDER unset and the feature is off with a reason on
# the page. Set it, and every one of these must be right or the container refuses
# to start. The key lives HERE and nowhere else: compose interpolates it, the
# service strips it from every evaluation subprocess, and `docker inspect` shows it
# to anyone with docker access on this box — it is protected from submitted code,
# not from colleagues.
# LLM_PROVIDER=anthropic          # anthropic | openai | local (vLLM, below) | fake (tests)
# LLM_MODEL=claude-sonnet-4-5     # pinned; recorded in every provenance record
# LLM_API_KEY=                    # from the provider console; never commit this file
# LLM_MAX_ITEMS_PER_BATCH=200     # batch requests per click (one per proposal, one per 10 items)
# LLM_DAILY_ITEM_CAP=2000         # batch requests per day, per paid provider (Review tab)
# LOCAL_DAILY_ITEM_CAP=           # the same for `local`; unset = no limit (it costs nothing)
# DATASET_QUOTA_GB=20             # generated datasets live under $BENCH_ROOT/datasets

# The exam writer (scripts/exam_build.py draft). Drafts candidate questions per topic
# for a person to curate on the Exam tab; nothing it writes reaches the live bank
# unread. Keep it a DIFFERENT provider from the judge: a loop whose questions, grades
# and training data all come from one family grades itself.
# EXAM_PROVIDER=openai
# EXAM_MODEL=gpt-4.1-2025-04-14
# EXAM_API_KEY=

# The judge (scripts/judge.py): an API call through the same batch client, with its OWN
# identity. Three rules, enforced: JUDGE_PROVIDER differs from EXAM_PROVIDER and
# LLM_PROVIDER (or the loop grades its own family — ALLOW_SINGLE_PROVIDER_LOOP=1 overrides
# for a trial and stamps every judged score); JUDGE_MODEL is a DATED id, never a floating
# alias; a thirty-script canary is re-graded every run and movement past
# JUDGE_CANARY_MAX_DRIFT marks the run preliminary. "stub" is the plumbing stand-in.
# JUDGE_PROVIDER=anthropic
# JUDGE_MODEL=claude-sonnet-4-5-20250929
# JUDGE_API_KEY=
# JUDGE_CANARY_MAX_DRIFT=0.5
# ALLOW_SINGLE_PROVIDER_LOOP=0
# Propose from a topic although the judge's grades are not evidence yet (a local
# judge, not calibrated against a person, single provider, draft rubric): the page
# asks, a person ticks "I understand these grades are not evidence", and the
# proposal, its spec, its dataset's provenance.json and any model trained on it are
# marked "proposed over a provisional judge". Reasons about the DATA (too few
# questions, nothing written, collapsed output) are never overridable. 0 restores
# the hard gate: the button disabled, the old words.
# ALLOW_PRELIMINARY_OVERRIDE=1
# JUDGED_TASKS_DIR=/home/masein/benchmarks/exam/tasks

# The `local` provider: vLLM's OpenAI-compatible server on this box, usable for any of
# the three roles above (SERVICE.md § The local model). It listens on LOOPBACK ONLY —
# from another machine, tunnel it: ssh -L 8000:localhost:8000 <box>. Inside the service
# container localhost is the container, so compose defaults this to the host gateway
# (host.docker.internal); on the host, leave it unset. No key: vLLM ignores one unless launched
# with --api-key. The model id is what `curl -s localhost:8000/v1/models` lists (here
# `chat`), and it cannot be pinned — so EVERYTHING a local identity produces is stamped
# provisional: never ranked, never in an average. There is no flag to turn that off.
# All three roles on `local` is a provider clash and needs ALLOW_SINGLE_PROVIDER_LOOP=1.
#   LLM_PROVIDER=local    LLM_MODEL=chat
#   EXAM_PROVIDER=local   EXAM_MODEL=chat
#   JUDGE_PROVIDER=local  JUDGE_MODEL=chat
#   ALLOW_SINGLE_PROVIDER_LOOP=1
# LOCAL_BASE_URL=http://localhost:8000/v1
# LOCAL_CONCURRENCY=2          # requests in flight at once — the card is shared (~94% used)
# Reply caps, per role: only generation needs headroom (a ~600-word training
# document is ~1,400 tokens and the request already asks for ONE), while a
# judge's per-criterion reply is ~350 and an exam draft is shorter still.
# 1536 across two concurrent generation requests is well inside what the
# shared card has left with vLLM and Ollama both loaded.
# LOCAL_MAX_TOKENS_LLM=1536    # generation and proposals
# LOCAL_MAX_TOKENS_JUDGE=1024  # a 23-criterion reply is ~350 tokens
# LOCAL_MAX_TOKENS_EXAM=1024   # drafted questions
# LOCAL_MAX_TOKENS=            # set this to cap every role that has no knob of its own
# LOCAL_TIMEOUT_S=180          # per request; a timeout is retried after 2, 8 and 30 s
# 12r: a judge in another compose project (its container's name in LOCAL_BASE_URL,
# e.g. http://gemma-vllm:8000/v1): join its network for good, so a restart of
# that project can't cut the judge off. JUDGE_NETWORK names it.
# COMPOSE_FILE=docker-compose.yml:docker-compose.judge.yml
# JUDGE_NETWORK=teraformer-chat_default

# 12p.1: backups of what lives only on the data volume — Everyday's hidden set
# and the exam's questions — on another disk than BENCH_ROOT's
BACKUP_DIR=/data-03/evalboard-backups
# the age PUBLIC key `python -m service.hidden_store backup --export` encrypts
# to (age-keygen on your own machine; the private key never comes here)
EVALBOARD_BACKUP_AGE_RECIPIENT=

# 14.4.5: the full Mobile-MMLU (CC BY-NC-ND 4.0, internal research only). 0 hides
# it everywhere and refuses new runs of it; its files, picks and labels stay on
# disk, and 1 (the default) shows them again
# MOBILE_MMLU_FULL=1
# 16.5: the Knowledge exam. 0 (the default) hides it everywhere and runs, asks
# and generates nothing about it; its banks, rubrics, answers and judged scores
# stay on disk and in the database, and 1 brings everything back as it was
# KNOWLEDGE_EXAM=0
