# Copy to .env next to docker-compose.yml and fill in. One-liner:
#   cp .env.example .env && sed -i "s|^BIND=.*|BIND=$(tailscale ip -4)|" .env

# The directory that holds results/, eval_tasks/, logs/ (and gains service.sqlite3).
BENCH_ROOT=/home/masein/benchmarks

# Your HF cache+auth dir (holds downloaded models AND your accepted licenses).
HF_HOME=/home/masein/hf-cache

# The IP to publish on — your Tailscale IP, so only the tailnet can reach it.
BIND=100.0.0.0

# Optional:
# TZ=Asia/Qatar            # timestamps on the dashboard render in this zone
# TITLE=Team model benchmark — teraformer-5090-3
# MAX_PARAMS_B=4
# SUBMIT_TOKEN=change-me-then-share-http://host:8899/?token=change-me

# ARTIFACT_MAX_GB=8        # per-checkpoint upload cap
# ARTIFACT_QUOTA_GB=150    # total artifact storage
# CONTROL_TASKS_DIR=/app/eval_tasks/mmlu_perm   # where suite=control finds mmlu_perm; the repo copy by default

# The LLM behind "propose a skill spec" and data generation (DIAGNOSE.md, phase 4).
# Batch API only. Leave LLM_PROVIDER unset and the feature is off with a reason on
# the page. Set it, and every one of these must be right or the container refuses
# to start. The key lives HERE and nowhere else: compose interpolates it, the
# service strips it from every evaluation subprocess, and `docker inspect` shows it
# to anyone with docker access on this box — it is protected from submitted code,
# not from colleagues.
# LLM_PROVIDER=anthropic          # anthropic | openai | fake (tests)
# LLM_MODEL=claude-sonnet-4-5     # pinned; recorded in every provenance record
# LLM_API_KEY=                    # from the provider console; never commit this file
# LLM_MAX_ITEMS_PER_BATCH=200     # batch requests per click (one per proposal, one per 10 items)
# LLM_DAILY_ITEM_CAP=2000         # batch requests per day, shown on the Review tab
# DATASET_QUOTA_GB=20             # generated datasets live under $BENCH_ROOT/datasets

# The exam writer (scripts/exam_build.py draft). Drafts candidate questions per topic
# for a person to curate on the Exam tab; nothing it writes reaches the live bank
# unread. Keep it a DIFFERENT provider from the judge: a loop whose questions, grades
# and training data all come from one family grades itself.
# EXAM_PROVIDER=openai
# EXAM_MODEL=gpt-4.1-2025-04-14
# EXAM_API_KEY=

# The judge (scripts/judge.py): an API call through the same batch client, with its OWN
# identity. Three rules, enforced: JUDGE_PROVIDER differs from EXAM_PROVIDER and
# LLM_PROVIDER (or the loop grades its own family — ALLOW_SINGLE_PROVIDER_LOOP=1 overrides
# for a trial and stamps every judged score); JUDGE_MODEL is a DATED id, never a floating
# alias; a thirty-script canary is re-graded every run and movement past
# JUDGE_CANARY_MAX_DRIFT marks the run preliminary. "stub" is the plumbing stand-in.
# JUDGE_PROVIDER=anthropic
# JUDGE_MODEL=claude-sonnet-4-5-20250929
# JUDGE_API_KEY=
# JUDGE_CANARY_MAX_DRIFT=0.5
# ALLOW_SINGLE_PROVIDER_LOOP=0
# JUDGED_TASKS_DIR=/home/masein/benchmarks/exam/tasks
