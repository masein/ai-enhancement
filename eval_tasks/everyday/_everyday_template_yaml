# Everyday tasks (briefs 12a, 12a.2). everyday.build_task() copies this
# into the run's task directory with the items file's absolute path filled
# in, as exam_build does for the exam: lm_eval resolves data_files relative
# to nothing useful.
#
# Not _fr_template_yaml: its "Answer:" suffix is exactly what a person on a
# phone never types. The question goes to the model as it was typed, inside
# the model's own chat template (the runner always passes
# --apply_chat_template for this suite).
dataset_path: json
dataset_kwargs:
  data_files:
    test: __ITEMS_PATH__
test_split: test
output_type: generate_until
doc_to_text: "{{prompt}}"
doc_to_target: ""
generation_kwargs:
  # a stop no chat answer writes, so the end of the model's turn is what ends
  # it (the harness always adds the tokenizer's end of text). Left out, the
  # harness can fall back to its few-shot delimiter, a blank line, which
  # would cut the JSON, the email, and Qwen3's "<think>\n\n</think>"
  until: ["\n\n\n\n"]
  # a reasoning model gets REASONING_MAX_GEN_TOKS instead (--gen_kwargs)
  max_gen_toks: 512
  do_sample: false
  temperature: 0.0
# no metric: scripts/everyday.py marks the answers and writes everyday.json
# beside the model's results; the harness only records what the model wrote
metric_list:
  - metric: bypass
metadata:
  version: 1.0
